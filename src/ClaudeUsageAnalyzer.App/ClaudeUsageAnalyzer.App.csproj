<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ClaudeUsageAnalyzer</RootNamespace>
    <AssemblyName>ClaudeUsageAnalyzer</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Unpackaged, self-contained: a plain folder with one .exe, no MSIX, no
         prerequisites on the target machine. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- WinUI and the reflective bridge dispatch do not survive trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <UiDir>$(MSBuildThisFileDirectory)..\ClaudeUsageAnalyzer.UI\</UiDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed at runtime too: AppWindow.SetIcon reads the file, it does not use
         the icon compiled into the executable. -->
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Build-time tool, not a runtime asset. -->
    <Content Remove="Assets\generate-icon.ps1" />
    <None Include="Assets\generate-icon.ps1" />
  </ItemGroup>

  <Target Name="BuildUi" BeforeTargets="AssignTargetPaths" Condition="'$(SkipUiBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(UiDir)" Condition="!Exists('$(UiDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(UiDir)" />
  </Target>

  <!-- The Content items must be created inside a target that runs after the UI
       build. A static ItemGroup is evaluated before any target runs, so on a
       fresh clone wwwroot would still be empty at evaluation time and nothing
       would be copied. -->
  <Target Name="IncludeUiOutput" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildUi">
    <ItemGroup>
      <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeUsageAnalyzer.Core\ClaudeUsageAnalyzer.Core.csproj" />
  </ItemGroup>

</Project>
