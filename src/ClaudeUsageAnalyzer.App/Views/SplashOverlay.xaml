<UserControl
    x:Class="ClaudeUsageAnalyzer.Views.SplashOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Scale and opacity are composition-driven, so this runs off the UI
             thread and keeps moving even while the WebView2 is starting up.
             Animating Height instead would need EnableDependentAnimation and
             would stutter exactly when the app is busiest. -->
        <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Bar1Scale"
                Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0.35" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="0.35">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0.35" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Bar2Scale"
                Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0.35" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="0.35" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.65" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.25" Value="0.35">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0.35" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="Bar3Scale"
                Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0.35" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0.35" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0.35">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0.35" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="24">

            <!-- The same three ascending bars as the app icon. -->
            <Grid Height="56" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Bottom">
                    <Rectangle
                        Width="12" Height="30" RadiusX="2" RadiusY="2"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}"
                        VerticalAlignment="Bottom"
                        RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Bar1Scale" ScaleY="0.35" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle
                        Width="12" Height="44" RadiusX="2" RadiusY="2"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}"
                        VerticalAlignment="Bottom"
                        RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Bar2Scale" ScaleY="0.35" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle
                        Width="12" Height="56" RadiusX="2" RadiusY="2"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}"
                        VerticalAlignment="Bottom"
                        RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="Bar3Scale" ScaleY="0.35" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="ClaudeUsageAnalyzer" />
                <TextBlock
                    x:Name="StatusText"
                    HorizontalAlignment="Center"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Starting…" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
