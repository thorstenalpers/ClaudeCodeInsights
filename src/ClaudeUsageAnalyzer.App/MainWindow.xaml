<Window
    x:Class="ClaudeUsageAnalyzer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ClaudeUsageAnalyzer.Views">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Source is deliberately absent. Setting it here would create a default
             CoreWebView2Environment, and the explicit one that redirects the user
             data folder could then no longer be applied.

             Hidden via Opacity, never via Visibility: a collapsed WebView2 does
             not composite, so requestAnimationFrame never fires inside it and the
             app.ready handshake would wait forever for a frame that is not
             coming. Opacity 0 still paints. -->
        <WebView2 x:Name="WebView" Opacity="0" />

        <views:SplashOverlay x:Name="Splash" />

        <views:HostErrorPanel x:Name="ErrorPanel" Visibility="Collapsed" />
    </Grid>
</Window>
