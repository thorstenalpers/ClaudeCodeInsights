<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Product>ClaudeUsageAnalyzer</Product>
    <Version>0.1.0</Version>

    <!-- x64 everywhere. WinUI plus the win-x64 RID make the host x64-only, and a
         mixed AnyCPU/x64 solution makes Visual Studio ask for a configuration
         the host project does not have. -->
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <!-- Warnings block the build only in Release, so generated WinUI code does not
       stall day-to-day work while CI still refuses to let one through. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
