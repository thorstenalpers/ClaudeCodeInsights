{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Claude Code Insights",
	"version": "0.1.0",
	"identifier": "dev.thor.claudeadmin",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5177",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Claude Code Insights",
				"width": 1280,
				"height": 672,
				"minWidth": 380,
				"minHeight": 480,
				"resizable": true,
				"center": true,
				"visible": true
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"webviewInstallMode": {
				"type": "downloadBootstrapper",
				"silent": true
			}
		},
		"resources": {
			"runtime/*.dll": ""
		}
	}
}
