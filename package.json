{
	"name": "claude-admin",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"start": "tauri dev",
		"npm:install": "npm i",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"dev": "vite dev",
		"build": "vite build",
		"verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
		"inspect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/inspect.ps1",
		"app:build": "node scripts/require-closed.mjs && tauri build",
		"app:exe": "node scripts/require-closed.mjs && tauri build --debug --no-bundle && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-exe.ps1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.48.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/table-core": "^9.2.4",
		"@tauri-apps/cli": "^2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^26.6.3",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"layerchart": "^2.5.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~7.0.2",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1"
	},
	"dependencies": {
		"@tauri-apps/api": "^2"
	}
}
